# Copy to .env.local for local dev. For Docker, these are passed as BUILD
# ARGS (see ../docker-compose.yml) because Next.js inlines NEXT_PUBLIC_*
# values into the client bundle at build time, not read at container
# start -- setting them only as runtime env vars on a built image has no
# effect.

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
NEXT_PUBLIC_API_URL=http://localhost:8000
