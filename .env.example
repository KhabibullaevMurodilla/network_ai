# Copy this file to `.env` (same folder as docker-compose.yml) and fill in
# the six REQUIRED values below. `.env` is git-ignored; never commit it.
#
#   cp .env.example .env
#
# Every REQUIRED value comes from your own Supabase project:
#   Supabase dashboard -> Project Settings -> API
# (and you must first run supabase/schema.sql in its SQL editor -- see
# DEPLOY.md section 1). These cannot be invented or defaulted: they point
# the app at YOUR database and let it verify YOUR users' logins.

# ---- REQUIRED ---------------------------------------------------------
# "Project URL"
SUPABASE_URL=
# Supabase dashboard -> Project Settings -> API Keys.
# Newer projects: the "Secret key" (sb_secret_...). Older: "service_role".
# Either works here. BACKEND ONLY -- it bypasses row-level security.
# Never put it in a NEXT_PUBLIC_* variable.
SUPABASE_SERVICE_ROLE_KEY=
# OPTIONAL. Only for projects whose logins are signed with the legacy shared
# secret (HS256): Project Settings -> JWT Keys -> Legacy JWT Secret.
# Newer projects sign logins with an asymmetric key; the backend then verifies
# them automatically from SUPABASE_URL (no secret needed) -- leave this empty.
SUPABASE_JWT_SECRET=
# Same Project URL as above (the browser app needs it too)
NEXT_PUBLIC_SUPABASE_URL=
# Newer projects: the "Publishable key" (sb_publishable_...). Older: "anon".
# Safe for the browser.
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Exact origin(s) the browser app is served from, comma-separated. No
# wildcard: empty/wrong = every browser request is rejected (CORS).
ALLOWED_ORIGINS=http://localhost:3000

# ---- Optional (sane defaults) -----------------------------------------
# Where the BROWSER reaches the backend (baked into the frontend at build
# time -- rebuild with `docker compose up --build` after changing it).
NEXT_PUBLIC_API_URL=http://localhost:8000
INGEST_RATE_LIMIT=120/minute
LOG_LEVEL=INFO

# Stripe billing (inert until set)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_STARTER=
STRIPE_PRICE_PRO=

# Email alert channel (v6.3): without SMTP_HOST, email channels are a no-op
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=alerts@your-domain.example
SMTP_USE_TLS=true

# Public read-only /demo page (v6.3): id of a tenant seeded with
# scripts/seed_demo_tenant.py. Empty = /demo returns 404.
DEMO_TENANT_ID=

# Learning period for newly seen devices (flows judged only after this many; 0 = off)
ENTITY_LEARNING_MIN_FLOWS=50
